{
  "name": "aidepilot",
  "version": "1.0.1",
  "description": "A modern, lightweight API testing client — like Postman, but faster and cleaner",
  "private": true,
  "author": "AidePilot",
  "main": "electron/main.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && cross-env AIDEPLOT_ELECTRON_VITE=1 electron .\"",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && node scripts/make-ico.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && node scripts/make-ico.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "start": "npm run build && npm run start --workspace=backend"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "sql.js": "^1.12.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.aidepilot.app",
    "productName": "AidePilot",
    "copyright": "Copyright © AidePilot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "backend/dist/**/*",
      "frontend/dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,*.map}",
      "!frontend/src/**",
      "!backend/src/**",
      "!**/*.ts",
      "!**/*.tsx"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/dist/**"
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AidePilot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
